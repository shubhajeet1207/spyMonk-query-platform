# Documentation and license shipped with the sdist
include README.md
include LICENSE

# Configuration files
include pyproject.toml

# Proto sources and generated gRPC files
recursive-include spymonk_enterprise *.proto
recursive-include spymonk_enterprise/network/grpc/gen *.py

# Type marker
recursive-include spymonk_enterprise py.typed

# Exclude development files
exclude .gitignore
exclude .env*
recursive-exclude tests *
recursive-exclude benchmarks *
recursive-exclude docs *
recursive-exclude examples *
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store
