# Frontend build-time configuration (Vite). Copy to .env.local for development.

# Where the backend API lives. Leave unset for:
#   - dev:        defaults to http://localhost:8000
#   - production: defaults to same-origin (backend serves the frontend)
VITE_API_URL=http://localhost:8000

# API key sent as X-API-Key. Must be one of the backend's ALLOWED_API_KEYS.
VITE_API_KEY=dev-key-12345
