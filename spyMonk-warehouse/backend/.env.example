# ========================================
# spyMonk-warehouse Backend Configuration
# ========================================

# API Security
# Generate with: openssl rand -hex 32
API_SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY_HEADER=X-API-Key

# Generate secure API keys for clients
# You can have multiple keys separated by commas
ALLOWED_API_KEYS=dev-key-12345,frontend-key-67890,mobile-key-abcdef

# CORS Configuration
# Add your frontend domains (comma-separated)
# For development: http://localhost:5173
# For production: https://your-app.pages.dev,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173

# ========================================
# spyMonk-DB Connection Settings
# ========================================

# Database Mode: true = distributed cluster, false = embedded single node
USE_DISTRIBUTED_MODE=false

# For Distributed Mode:
# Comma-separated list of database node addresses
# Example: node1.railway.app:5000,node2.railway.app:5001,node3.railway.app:5002
SPYMONK_DB_NODES=localhost:5000,localhost:5001,localhost:5002

# Database authentication token (must match the token in spyMonk-DB nodes)
# Generate with: openssl rand -hex 32
SPYMONK_DB_AUTH_TOKEN=your-db-auth-token-change-me

# For Embedded Mode:
# Local directory path for database storage
DATABASE_PATH=data/spymonk_warehouse_db

# ========================================
# Rate Limiting
# ========================================

# General API rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# File upload rate limit (uploads per minute per IP)
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# ========================================
# File Upload Settings
# ========================================

# Maximum file size in megabytes
UPLOAD_MAX_SIZE_MB=100

# ========================================
# Application Settings
# ========================================

# Environment: development or production
# In production mode:
# - API docs are disabled
# - Detailed error messages are hidden
# - HTTPS is enforced
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Force HTTPS redirect (set to true in production)
ENABLE_HTTPS_REDIRECT=false

# ========================================
# AI Assistant Settings
# ========================================

# OpenAI-compatible chat completions endpoint.
# Keep this key backend-only. Never expose it as VITE_*.
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=z-ai/glm-5.2
AI_TIMEOUT_SECONDS=12

# ========================================
# Development vs Production Examples
# ========================================

# DEVELOPMENT:
# USE_DISTRIBUTED_MODE=false
# DATABASE_PATH=data/spymonk_warehouse_db
# ENVIRONMENT=development
# ALLOWED_API_KEYS=
# CORS_ORIGINS=http://localhost:5173

# PRODUCTION:
# USE_DISTRIBUTED_MODE=true
# SPYMONK_DB_NODES=db1.railway.app:5000,db2.railway.app:5001,db3.railway.app:5002
# SPYMONK_DB_AUTH_TOKEN=<your-secure-token>
# ENVIRONMENT=production
# ALLOWED_API_KEYS=<secure-key-1>,<secure-key-2>
# CORS_ORIGINS=https://your-app.pages.dev
# ENABLE_HTTPS_REDIRECT=true
